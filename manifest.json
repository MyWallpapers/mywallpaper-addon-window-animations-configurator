      "max": 250,
      "step": 5,
      "parent": "rulesSection",
      "showIf": {
        "setting": "rule3Enabled",
        "equals": true
      }
    },
    {
      "id": "comfortSection",
      "type": "section",
      "label": "Confort et compatibilité",
      "defaultCollapsed": false
    },
    {
      "id": "respectReducedMotion",
      "type": "boolean",
      "label": "Respecter les animations réduites de Windows",
      "default": true,
      "scope": "device",
      "parent": "comfortSection",
      "description": "Suspend les effets si Windows désactive les animations. Un changement de ce choix pendant un effet termine immédiatement cet effet."
    },
    {
      "id": "skipFullscreen",
      "type": "boolean",
      "label": "Ignorer les fenêtres plein écran",
      "default": true,
      "scope": "device",
      "parent": "comfortSection"
    },
    {
      "id": "hideEntering",
      "type": "boolean",
      "label": "Masquer la vraie fenêtre pendant son apparition",
      "default": true,
      "scope": "device",
      "parent": "comfortSection",
      "description": "La capture remplace temporairement la fenêtre lors de l’ouverture et de la restauration. Un processus de surveillance la réaffiche en cas d’arrêt brutal."
    },
    {
      "id": "allowTranslucent",
      "type": "boolean",
      "label": "Essayer les fenêtres translucides · expérimental",
      "default": false,
      "scope": "device",
      "parent": "comfortSection",
      "description": "La capture de verre, Mica et des applications accélérées peut être vide ou différente de l’original. Un échec de capture laisse la fenêtre visible."
    },
    {
      "id": "performanceSection",
      "type": "section",
      "label": "Fluidité et ressources",
      "defaultCollapsed": true
    },
    {
      "id": "frameRate",
      "type": "range",
      "label": "Images par seconde visées",
      "default": 60,
      "scope": "device",
      "min": 30,
      "max": 60,
      "step": 30,
      "parent": "performanceSection",
      "description": "30 réduit le travail de rendu ; 60 privilégie la fluidité. Le débit effectif dépend de la taille de la fenêtre et du processeur."
    },
    {
      "id": "meshQuality",
      "type": "range",
      "label": "Finesse de Genie et Wobbly",
      "default": 20,
      "scope": "device",
      "min": 8,
      "max": 40,
      "step": 2,
      "parent": "performanceSection",
      "description": "Une valeur élevée affine les courbes et augmente le coût du rendu."
    },
    {
      "id": "maxConcurrent",
      "type": "range",
      "label": "Effets simultanés",
      "default": 3,
      "scope": "device",
      "min": 1,
      "max": 4,
      "step": 1,
      "parent": "performanceSection"
    },
    {
      "id": "maxSnapshots",
      "type": "range",
      "label": "Fenêtres gardées en mémoire",
