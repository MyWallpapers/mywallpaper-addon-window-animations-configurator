      "default": "out",
      "scope": "device",
      "options": [
        {
          "value": "out",
          "label": "Rapide au départ, douce à l’arrivée"
        },
        {
          "value": "smooth",
          "label": "Douce au départ et à l’arrivée"
        },
        {
          "value": "inout",
          "label": "Accélérer puis ralentir"
        },
        {
          "value": "linear",
          "label": "Vitesse constante"
        }
      ],
      "parent": "motionSection",
      "showIf": {
        "setting": "profile",
        "equals": "custom"
      }
    },
    {
      "id": "slideDistance",
      "type": "range",
      "label": "Distance du glissement (px)",
      "default": 54,
      "scope": "device",
      "min": 0,
      "max": 400,
      "step": 2,
      "parent": "motionSection",
      "description": "Distance à 100 % d’amplitude ; adaptée au DPI de la fenêtre.",
      "showIf": {
        "setting": "profile",
        "equals": "custom"
      }
    },
    {
      "id": "startSize",
      "type": "range",
      "label": "Taille de départ du zoom (%)",
      "default": 86,
      "scope": "device",
      "min": 10,
      "max": 100,
      "step": 1,
      "parent": "motionSection",
      "showIf": {
        "setting": "profile",
        "equals": "custom"
      }
    },
    {
      "id": "startOpacity",
      "type": "range",
      "label": "Visibilité au début ou à la fin (%)",
      "default": 8,
      "scope": "device",
      "min": 0,
      "max": 100,
      "step": 1,
      "parent": "motionSection",
      "description": "0 % disparaît complètement ; 100 % garde l’image opaque.",
      "showIf": {
        "setting": "profile",
        "equals": "custom"
      }
    },
    {
      "id": "bounce",
      "type": "range",
      "label": "Force du rebond (%)",
      "default": 14,
      "scope": "device",
      "min": 0,
      "max": 60,
      "step": 1,
      "parent": "motionSection",
      "showIf": {
        "setting": "profile",
        "equals": "custom"
      }
    },
    {
      "id": "damping",
      "type": "range",
      "label": "Calmer le rebond",
      "default": 7,
      "scope": "device",
      "min": 2,
      "max": 16,
      "step": 1,
      "parent": "motionSection",
      "description": "Une valeur élevée amortit le rebond et la déformation plus vite.",
      "showIf": {
        "setting": "profile",
        "equals": "custom"
      }
    },
    {
      "id": "wobbleAmount",
      "type": "range",
      "label": "Souplesse Wobbly (px)",
      "default": 18,
      "scope": "device",
      "min": 0,
      "max": 120,
      "step": 1,
      "parent": "motionSection",
      "description": "Déforme une capture pendant la transition ; le déplacement interactif d’une fenêtre n’est pas déformé.",
      "showIf": {
        "setting": "profile",
        "equals": "custom"
      }
    },
    {
      "id": "wobbleFrequency",
      "type": "range",
      "label": "Ondulations Wobbly",
      "default": 3,
      "scope": "device",
      "min": 1,
      "max": 8,
      "step": 1,
      "parent": "motionSection",
      "showIf": {
        "setting": "profile",
        "equals": "custom"
      }
    },
    {
      "id": "originSection",
      "type": "section",
      "label": "Direction et origine",
      "defaultCollapsed": false
    },
    {
      "id": "origin",
      "type": "select",
      "label": "Origine du mouvement",
      "default": "bottom",
      "scope": "device",
      "options": [
        {
          "value": "bottom",
          "label": "Bas de l’écran"
        },
        {
          "value": "top",
          "label": "Haut de l’écran"
        },
        {
          "value": "left",
          "label": "Bord gauche"
        },
        {
          "value": "right",
          "label": "Bord droit"
        },
        {
          "value": "center",
          "label": "Centre de la fenêtre"
        },
        {
          "value": "cursor",
          "label": "Position du pointeur"
        },
        {
          "value": "taskbar",
          "label": "Bord de la barre des tâches"
        }
      ],
      "parent": "originSection",
      "description": "Dirige le glissement et le ressort, et attire Genie vers ce point. Le zoom suit aussi le pointeur ou la barre des tâches. Le bord de la barre est estimé sur l’écran de la fenêtre, sans cibler une icône précise."
    },
    {
      "id": "lookSection",
      "type": "section",
      "label": "Aspect pendant le mouvement",
      "defaultCollapsed": true
    },
    {
      "id": "cornerRadius",
      "type": "range",
      "label": "Coins arrondis (px)",
      "default": 12,
      "scope": "device",
      "min": 0,
      "max": 48,
      "step": 1,
      "parent": "lookSection",
      "description": "Arrondit seulement la capture animée ; l’apparence normale de la fenêtre reste gérée par son application."
    },
    {
      "id": "shadowSize",
      "type": "range",
      "label": "Ombre douce (px)",
