      "scope": "device",
      "min": 1,
      "max": 24,
      "step": 1,
      "parent": "performanceSection",
      "description": "Les captures restent en mémoire, dans une limite totale de 64 Mo. Les fenêtres supplémentaires utilisent Windows."
    },
    {
      "id": "cacheInterval",
      "type": "range",
      "label": "Actualiser les captures tous les (ms)",
      "default": 400,
      "scope": "device",
      "min": 100,
      "max": 2000,
      "step": 50,
      "parent": "performanceSection",
      "description": "Les fermetures et réductions utilisent la dernière capture disponible."
    },
    {
      "id": "cacheMaxAge",
      "type": "range",
      "label": "Âge maximal d’une capture (ms)",
      "default": 2000,
      "scope": "device",
      "min": 250,
      "max": 5000,
      "step": 50,
      "parent": "performanceSection",
      "description": "Une capture trop ancienne est ignorée pour éviter d’animer un contenu périmé."
    }
  ],
