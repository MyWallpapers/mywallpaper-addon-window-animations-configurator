{
  "runtime": "native-v1",
  "name": "Animations des fenêtres",
  "version": "0.1.1",
  "deviceSettingsVersion": "1",
  "description": "Personnalisez les quatre transitions de vos fenêtres avec des ambiances, Genie, des rebonds et des profils par application.",
  "settings": [
    {
      "id": "enabled",
      "type": "boolean",
      "label": "Animer les fenêtres",
      "default": true,
      "scope": "device",
      "description": "Applique les effets aux applications choisies. Désactiver termine les effets et réaffiche les fenêtres."
    },
    {
      "id": "profile",
      "type": "select",
      "label": "Ambiance",
      "default": "fluid",
      "scope": "device",
      "options": [
        {
          "value": "fluid",
          "label": "Fluide et expressif"
        },
        {
          "value": "discreet",
          "label": "Discret · fondu rapide"
        },
        {
          "value": "cinema",
          "label": "Cinéma · ample et progressif"
        },
        {
          "value": "bounce",
          "label": "Ressort · rebond vivant"
        },
        {
          "value": "genie",
          "label": "Genie · vers le bord de l’écran"
        },
        {
          "value": "wobbly",
          "label": "Wobbly · déformation expérimentale"
        },
        {
          "value": "custom",
          "label": "Personnalisée"
        }
      ],
      "description": "Les ambiances règlent les quatre mouvements. Choisissez Personnalisée pour régler chaque mouvement et sa durée."
    },
    {
      "id": "speed",
      "type": "range",
      "label": "Vitesse (%)",
      "default": 100,
      "scope": "device",
      "min": 25,
      "max": 250,
      "step": 5,
      "description": "100 % correspond au profil. Une valeur plus élevée accélère les effets."
    },
    {
      "id": "intensity",
      "type": "range",
      "label": "Amplitude (%)",
      "default": 100,
      "scope": "device",
      "min": 0,
      "max": 200,
      "step": 5,
      "description": "Augmente le déplacement, le zoom, le rebond et la déformation sans changer la vitesse."
    },
    {
      "id": "eventsSection",
      "type": "section",
      "label": "Quels moments animer ?",
      "defaultCollapsed": false
    },
    {
      "id": "openEnabled",
      "type": "boolean",
      "label": "À l’ouverture",
      "default": true,
      "scope": "device",
      "parent": "eventsSection",
      "description": "La fenêtre apparaît avec le mouvement choisi. Une apparition initiale peut précéder l’effet."
    },
    {
      "id": "closeEnabled",
      "type": "boolean",
      "label": "À la fermeture",
      "default": true,
      "scope": "device",
      "parent": "eventsSection",
      "description": "Anime la dernière capture disponible après la fermeture. Une fenêtre ouverte très brièvement peut être ignorée."
    },
    {
      "id": "minimizeEnabled",
      "type": "boolean",
      "label": "À la réduction",
      "default": true,
      "scope": "device",
      "parent": "eventsSection",
      "description": "Anime une capture de la fenêtre vers le bord choisi. L’animation Windows peut aussi se jouer."
    },
    {
      "id": "restoreEnabled",
      "type": "boolean",
      "label": "À la restauration",
      "default": true,
      "scope": "device",
      "parent": "eventsSection",
      "description": "Rejoue un mouvement d’apparition quand la fenêtre sort de la barre des tâches."
    },
    {
      "id": "appsSection",
      "type": "section",
      "label": "Applications et fenêtres",
      "defaultCollapsed": false
    },
    {
      "id": "applications",
      "type": "textarea",
      "label": "Applications à animer",
      "default": "notepad.exe",
      "scope": "device",
      "placeholder": "notepad.exe\ncalc.exe",
      "parent": "appsSection",
      "description": "Un nom de programme par ligne, par exemple notepad.exe ou calc.exe. Plusieurs fenêtres de ces programmes sont suivies, y compris si elles s’ouvrent plus tard."
    },
    {
      "id": "excludedApplications",
      "type": "textarea",
      "label": "Applications à laisser tranquilles",
      "default": "",
      "scope": "device",
      "parent": "appsSection",
      "description": "Un nom de programme par ligne. Cette liste a priorité sur les profils particuliers."
    },
    {
      "id": "windowTypes",
      "type": "select",
      "label": "Types de fenêtres",
      "default": "normal",
      "scope": "device",
      "options": [
        {
          "value": "normal",
          "label": "Fenêtres principales"
        },
        {
          "value": "dialog",
          "label": "Boîtes de dialogue"
        },
        {
          "value": "all",
          "label": "Fenêtres et boîtes de dialogue"
        }
      ],
      "parent": "appsSection",
      "description": "Les fenêtres système et les outils flottants sont ignorés. Le type est déduit de la classe et du propriétaire de la fenêtre."
    },
    {
      "id": "previewVisible",
      "type": "boolean",
      "label": "Afficher les fenêtres d’essai",
      "default": false,
      "scope": "device",
      "parent": "appsSection",
      "description": "Ouvre un petit panneau avec Ouvrir, Réduire, Restaurer et Fermer. Les essais utilisent exactement le rendu natif de cet add-on."
    },
    {
      "id": "motionSection",
      "type": "section",
      "label": "Mouvements personnalisés",
      "defaultCollapsed": true
    },
    {
      "id": "openMode",
      "type": "select",
      "label": "Ouverture · mouvement",
      "default": "zoom",
      "scope": "device",
      "options": [
        {
          "value": "none",
          "label": "Aucun"
        },
        {
          "value": "fade",
          "label": "Fondu"
        },
        {
          "value": "slide",
          "label": "Glissement"
        },
        {
          "value": "zoom",
          "label": "Zoom"
        },
        {
          "value": "spring",
          "label": "Ressort"
        },
        {
          "value": "genie",
          "label": "Genie"
        },
        {
          "value": "wobbly",
          "label": "Wobbly · expérimental"
        }
      ],
      "parent": "motionSection",
      "showIf": {
        "setting": "profile",
        "equals": "custom"
      }
    },
    {
      "id": "openDuration",
      "type": "range",
      "label": "Ouverture · durée (ms)",
      "default": 280,
      "scope": "device",
      "min": 80,
      "max": 2000,
      "step": 10,
      "parent": "motionSection",
      "showIf": {
        "setting": "profile",
        "equals": "custom"
      }
    },
    {
      "id": "closeMode",
      "type": "select",
