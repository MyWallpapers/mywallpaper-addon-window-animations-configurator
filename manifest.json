    {
      "id": "color1",
      "type": "color",
      "label": "Couleur de départ",
      "default": "#64BFFAFF",
      "scope": "device",
      "alpha": true,
      "parent": "lookSection"
    },
    {
      "id": "color2",
      "type": "color",
      "label": "Couleur d’arrivée",
      "default": "#DF83FFFF",
      "scope": "device",
      "alpha": true,
      "parent": "lookSection",
      "showIf": {
        "setting": "borderStyle",
        "equals": "gradient"
      }
    },
    {
